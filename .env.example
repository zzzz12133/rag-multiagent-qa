# ============ LLM（兼容 OpenAI 接口，可使用 DeepSeek / 通义千问 / OpenAI） ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ============ 嵌入模型 ============
# local  = 本地 sentence-transformers（无需 API Key，首次运行自动下载 BAAI/bge-small-zh-v1.5）
# openai = 走 OPENAI_API_BASE 的 embeddings 接口（如 SiliconFlow）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============ 向量库 ============
# faiss = 本地索引（默认，零依赖）
# milvus = Milvus 服务（先 docker compose up -d 启动）
VECTOR_STORE=faiss
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprise_kb

# ============ 检索参数 ============
TOP_K=6
RERANK_TOP_N=3
BM25_TOP_K=6

# ============ Redis 缓存（留空则使用进程内缓存） ============
REDIS_URL=
CACHE_TTL=3600

# ============ 文档入库 ============
CHUNK_SIZE=500
CHUNK_OVERLAP=80
